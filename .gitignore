# 运行数据与个人隐私数据：默认不进版本库
data/*.db
data/*.db-wal
data/*.db-shm
data/attachments/
data/*.log
data/logs/

# 用户从飞书导出/下载的原始资料（个人工作内容）
飞书导出/

# 本机凭据（万一有人把配置放进来）
config/feishu.json
config/*.local.json

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器与系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 凭据文件备份
*.bak-*
*.bak

# 备份产物（可随时重新生成，不进版本库）
backup/

# 代码索引（派生产物，可用 tools/index_code.py build 重建）
.index/

# 前端依赖与构建产物（本地 npm install / npm run build 生成）
web/node_modules/
web/dist/
data/market/
collector/node_modules/

# BOSS 登录态（含 cookie，不要入库）
data/browser-profile*/
